# Accepted JSON datasets are hashed byte-for-byte. Preserve the line endings
# produced by each pipeline so Windows core.autocrlf cannot invalidate them.
data_pipeline/accepted_output_hashes.json text eol=lf
data_pipeline/raw/*.json text eol=crlf
data_pipeline/processed/*.json text eol=crlf
data_pipeline/identity/eu_common_ingredient_glossary/accepted/*.json text eol=crlf
data_pipeline/identity/eu_common_ingredient_glossary/raw/*.json text eol=crlf
data_pipeline/identity/eu_common_ingredient_glossary/processed/*.json text eol=crlf
data_pipeline/identity/eu_singapore_linkage/accepted/*.json text eol=lf
data_pipeline/identity/eu_singapore_linkage/inputs/review_decisions.json text eol=lf
